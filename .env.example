# .env.example
# =============
# Copy this to .env locally (`cp .env.example .env`) and fill in real values.
# .env itself is gitignored — never commit real secrets.
#
# On a platform like Railway/Render, these are typically NOT read from a
# committed .env file — set them as actual environment variables in the
# platform's dashboard/CLI instead.

# ── OpenAI (LLM calls: trend aggregation, listing copy, collection scoring,
#    ambiguous variant-option naming) ────────────────────────────────────────
OPENAI_API_KEY=

# ── CJ Dropshipping (supplier search, product detail, variants, videos) ─────
CJ_EMAIL=
CJ_API_KEY=

# ── Apify (Google Trends / TikTok / Instagram trend actors) ─────────────────
# Multiple keys supported as fallbacks (layer1/tools/apify_trends.py tries
# them in order). Only APIFY_API_TOKEN is required; the numbered ones are
# optional extras for rotating between accounts/quotas.
APIFY_API_TOKEN=
APIFY_API_TOKEN_1=
APIFY_API_TOKEN_2=
APIFY_API_TOKEN_3=

# Optional overrides — only needed if you swap which Apify actor is used.
# APIFY_GOOGLE_TRENDS_ACTOR=
# APIFY_INSTAGRAM_ACTOR=
# APIFY_TIKTOK_ACTOR=
# APIFY_TIKTOK_COUNTRY=US

# Optional trend-cache tuning (sensible defaults are hardcoded if unset).
# GOOGLE_TRENDS_CACHE_DIR=layer1/output/google_trends_cache
# GOOGLE_TRENDS_MAX_AGE_DAYS=3
# SOCIAL_TRENDS_CACHE_PATH=layer1/output/social_trends_cache.json
# SOCIAL_TRENDS_MAX_AGE_DAYS=7

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# ── Optional — competitor price lookups in PriceOptimizer ───────────────────
# Leave blank to skip competitor-price checks entirely (no error, just skipped).
SERPAPI_KEY=

# ── Pipeline config file location (optional override) ───────────────────────
# PIPELINE_CONFIG_PATH=config.json

# ── Scheduler / server (production deployment) ───────────────────────────────
# Protects the /trigger endpoint. Generate with: openssl rand -hex 24
ADMIN_TRIGGER_TOKEN=

# Where layer1/output and layer2/output get symlinked to on a persistent
# volume (e.g. a Railway Volume or Render Disk). Leave blank for local dev.
PERSISTENT_DISK_PATH=
# RENDER_DISK_PATH=

# Seconds to delay the scheduler's first tick after boot — only needed
# temporarily during an initial state migration onto a fresh persistent
# volume. Leave at 0 for normal operation and for local dev.
SCHEDULER_INITIAL_DELAY_SECONDS=0

# Local dev only — the platform sets this automatically in production.
# PORT=10000
